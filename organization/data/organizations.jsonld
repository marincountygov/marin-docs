        },
        {
          "@type": "PropertyValue",
          "propertyID": "local:marin-mentions-monitor-id",
          "value": "marin-supervisors"
        },
        {
          "@type": "PropertyValue",
          "propertyID": "local:marin-budget-department-code",
          "value": "330"
        }
      ],
      "areaServed": {
        "@id": "https://marincountygov.github.io/marin-data/id/jurisdiction/us-ca-marin"
      },
      "url": "https://MarinCounty.gov/Board",
      "alternateName": [
        "Marin Board of Supervisors"
      ],
      "parentOrganization": {
        "@id": "https://marincountygov.github.io/marin-data/id/organization/service-area-administration-and-finance"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3501 Civic Center Drive, Suite 329",
        "addressLocality": "San Rafael",
        "addressRegion": "CA",
        "postalCode": "94903",
        "addressCountry": "US"
      },
      "telephone": "415-473-7331",
      "description": "Under California’s Constitution and laws, the five members of the Board of Supervisors serve as the legislative and executive body of the County of Marin. Members are elected on a non- partisan basis by district and serve four-year terms. Within limits prescribed by state law, the Board enacts ordinances, determines policies, and adopts annual budgets for all County departments. Supervisors elect a President, Vice President, and Second Vice President annually among themselves. The Board serves on the governing boards of many special districts such as Marin County Open Space District, Marin Transit, and the Marin Housing Authority. In addition to serving on the Marin County Board of Supervisors, members of the Board also serve on external City, Regional, and State boards and commissions. DEPARTMENT BUDGET - BOARD OF SUPERVISORS"
    },
    {
