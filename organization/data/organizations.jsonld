          "value": "310"
        }
      ],
      "areaServed": {
        "@id": "https://marincountygov.github.io/marin-data/id/jurisdiction/us-ca-marin"
      },
      "url": "https://MarinCounty.gov/ARCC",
      "alternateName": [
        "Marin County Assessor-Recorder-County Clerk"
      ],
      "parentOrganization": {
        "@id": "https://marincountygov.github.io/marin-data/id/organization/service-area-administration-and-finance"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3501 Civic Center Dr., Suite 208",
        "addressLocality": "San Rafael",
        "addressRegion": "CA",
        "postalCode": "94903",
        "addressCountry": "US"
      },
      "telephone": "415-473-7215",
      "mission": "The mission of the Marin County Assessor-Recorder-County Clerk is to produce fair and uniform valuations of all assessable property and preserve and protect our historic and contemporary records and filings related to people, businesses, and property, as mandated by law, while providing excellent customer service. 3501 Civic Center Dr., Suite 208 San Rafael CA 94903 Tel: 415-473-7215 MarinCounty.gov/ARCC Shelly Scott",
      "description": "The Assessor-Recorder-County Clerk’s primary responsibilities, as governed by law, pertain to the preparation of the assessment roll, including, but not limited to, all locally assessable real, business and personal property within the County; the recordation, maintenance and preservation of official, vital and historic records; and the processing of oaths of office, marriage licenses, performance of civil ceremonies and the issuance and registration of a variety of legal documents. DEPARTMENT BUDGET - ASSESSOR-RECORDER COUNTY CLERK"
    },
    {
      "@id": "https://marincountygov.github.io/marin-data/id/organization/board",
      "@type": "GovernmentOrganization",
      "name": "Board of Supervisors",
      "organizationClassification": "legislature",
      "governmentLevel": "subregional",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:marin-links-agency-id",
          "value": "board"
        },
        {
          "@type": "PropertyValue",
