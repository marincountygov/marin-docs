    {
      "@id": "https://marincountygov.github.io/marin-data/id/organization/awm",
      "@type": "GovernmentOrganization",
      "name": "Agriculture, Weights and Measures",
      "organizationClassification": "department",
      "governmentLevel": "subregional",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "local:marin-links-agency-id",
