      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "88 Rowland Way, Suite 200",
        "addressLocality": "Novato",
        "addressRegion": "CA",
        "postalCode": "94945",
        "addressCountry": "US"
      },
      "telephone": "866-901-3212",
      "mission": "Children deserve the security of having their needs met. Parents are responsible for providing financial, medical and emotional support for their children. To achieve these goals, we establish and enforce child support orders, treating all parties with respect, and serve the community through outreach and education. Jill K. Francis",
      "description": "The Child Support Services program works with parents and guardians – both those receiving child support and those ordered to pay support – to ensure children and families receive court- ordered financial and medical support. DEPARTMENT BUDGET - CHILD SUPPORT SERVICES"
    },
