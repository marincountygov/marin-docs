          "value": "500"
        }
      ],
      "areaServed": {
        "@id": "https://marincountygov.github.io/marin-data/id/jurisdiction/us-ca-marin"
      },
      "url": "https://MarinCounty.gov/AWM",
      "alternateName": [
        "Marin County Agriculture, Weights and Measures"
      ],
      "parentOrganization": {
        "@id": "https://marincountygov.github.io/marin-data/id/organization/service-area-community-services"
      },
      "department": [
        {
          "@id": "https://marincountygov.github.io/marin-data/id/organization/awm-agriculture"
        },
        {
          "@id": "https://marincountygov.github.io/marin-data/id/organization/awm-weights-and-measures"
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "10 Avenue of the Flags",
        "addressLocality": "San Rafael",
        "addressRegion": "CA",
        "postalCode": "94903",
        "addressCountry": "US"
      },
      "telephone": "415-473-6400",
      "mission": "The mission of the Agriculture Weights and Measures Department is to serve the public’s interest by ensuring equity in the marketplace, promoting and protecting agriculture, protecting environmental quality and the health and welfare of Marin County’s residents. Joe Deviney",
      "description": "The Agriculture Weights and Measures Department includes two program areas: Agriculture and Weights and Measures. The Agriculture division’s mission is achieved by providing organic certification services; regulating pesticide use and investigating misuse; promoting Integrated Pest Management (IPM) principles and strategies, and other services. The Weights and Measures division’s mission is achieved through the rigorous inspection of commercial weighing and measuring devices as well as ensuring that every person receives the lowest advertised or posted price. DEPARTMENT BUDGET - AGRICULTURE, WEIGHTS AND MEASURES"
    },
