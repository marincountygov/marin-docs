      "alternateName": [
        "Marin County Probation"
      ],
      "parentOrganization": {
        "@id": "https://marincountygov.github.io/marin-data/id/organization/service-area-public-safety"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3501 Civic Center Drive, Suite 265",
        "addressLocality": "San Rafael",
        "addressRegion": "CA",
        "postalCode": "94903",
        "addressCountry": "US"
      },
      "telephone": "415.473.6599",
      "mission": "The Marin County Probation Department advances community safety and well-being through accountability, equity, and supportive rehabilitation. We partner with justice-involved individuals, victims, and the community to foster positive change, reduce harm, and build pathways to success. 3501 Civic Center Drive, Suite 265 San Rafael, CA 94903 Tel: 415.473.6599 MarinCounty.gov/Probation Marlon Washington",
      "description": "The Marin County Probation Department works to create safer, stronger communities by integrating accountability with opportunities for growth. Guided by our strategic priorities, we deliver fair court services, evidence-based supervision, and restorative programs that reduce recidivism and promote healing. We collaborate with the courts, law enforcement, schools, and community organizations to provide innovative interventions, expand equitable access to services, and support individuals in achieving lasting change. Our commitment to integrity, continuous improvement, and community partnership drives every aspect of our work. DEPARTMENT BUDGET - PROBATION"
    },
