      "@type": "Program",
      "name": "Housing and Federal Grants",
      "description": "Responsible for preserving and expanding the range and supply of adequate, accessible and affordable housing through housing policies, regulations and programs. Oversees the federal grant program to local governments administered by the Department of Housing and Urban Development (HUD).",
      "administeredBy": {
        "@id": "https://marincountygov.github.io/marin-data/id/organization/cda"
