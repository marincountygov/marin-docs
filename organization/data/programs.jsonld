    {
      "@id": "https://marincountygov.github.io/marin-data/id/program/hhs-social-services-veterans-services",
      "@type": "Program",
      "name": "Veterans Services",
      "description": "Provides referral and consultation services to the veterans of Marin County and their spouses, widows, widowers, and children. The Office of Veterans Services assists in obtaining the financial, medical, and education benefits due to veterans of military service.",
