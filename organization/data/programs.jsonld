    {
      "@id": "https://marincountygov.github.io/marin-data/id/program/hr-recruitment-and-classification",
      "@type": "Program",
      "name": "Recruitment and Classification",
      "description": "Conducts recruitments and advises department hiring managers on transparent, equitable, and effective hiring processes to ensure a well-qualified workforce. Manages the County’s classification and compensation plan by updating and developing accurate job classifications, conducting classification reviews, and analyzing and making recommendations on appropriate compensation.",
      "administeredBy": {
        "@id": "https://marincountygov.github.io/marin-data/id/organization/hr"
      },
