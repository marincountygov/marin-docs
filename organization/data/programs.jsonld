    {
      "@id": "https://marincountygov.github.io/marin-data/id/program/hr-benefits-wellness-and-hr-human-capital-management",
      "@type": "Program",
      "name": "Benefits, Wellness, and HR Human Capital Management",
      "description": "The Benefits, Wellness, and Human Capital Management Division directs the County’s comprehensive Benefits and Wellness Program to ensure that employees and their families receive high-quality benefits coverage, diverse plan options, and responsive employee support. The Division is dedicated to developing and implementing employee wellness initiatives that foster a culture of health care and well-being, and organizational support throughout the County. In collaboration with the Information Services and Finance Departments, the Division provides strategic oversight of payroll operations and Human Resources Information Systems (HRIS). This partnership ensures efficient, accurate, and integrated management of employee information, benefits, and payroll processes.",
      "administeredBy": {
        "@id": "https://marincountygov.github.io/marin-data/id/organization/hr"
      },
      "areaServed": {
        "@id": "https://marincountygov.github.io/marin-data/id/jurisdiction/us-ca-marin"
