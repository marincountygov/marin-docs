    {
      "@id": "https://marincountygov.github.io/marin-data/id/program/fire-fire-operations",
      "@type": "Program",
      "name": "Fire Operations",
      "description": "Encompasses fire suppression activities in the unincorporated areas of Marin and provides the personnel and equipment to respond to all-risk calls and support for other fire agencies in Marin County under a countywide mutual aid agreement. The Fire Department also contracts with the California Department of Forestry and Fire Protection (CAL FIRE) to provide staff and equipment for incidents throughout the state.",
