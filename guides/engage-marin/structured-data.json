    {
      "@type": "TechArticle",
      "@id": "https://data.marincounty.gov/guides/engage-marin/how-it-works.html",
      "url": "https://data.marincounty.gov/guides/engage-marin/how-it-works.html",
      "name": "How it works",
      "headline": "How it works",
      "description": "Engage Marin helps you manage community engagement from start to finish. You can ask one question or bring several related questions together in a campaign.",
      "inLanguage": "en",
      "audience": {
        "@type": "Audience",
        "audienceType": "County of Marin staff"
      },
      "publisher": {
        "@type": "GovernmentOrganization",
        "name": "County of Marin"
      },
      "isPartOf": {
        "@type": "CreativeWork",
        "@id": "https://data.marincounty.gov/guides/engage-marin/",
        "name": "Engage Marin Playbook"
      },
      "mainEntity": {
        "@type": "HowTo",
        "name": "How an Engage Marin engagement works",
        "step": [
          {
            "@type": "HowToStep",
            "position": 1,
            "name": "Plan",
            "text": "Decide what you want to learn, who you want to hear from, and how you'll use their feedback."
          },
          {
            "@type": "HowToStep",
            "position": 2,
            "name": "Create",
            "text": "Start a question or campaign. Add an About page, welcome video, and kickoff update."
          },
          {
            "@type": "HowToStep",
            "position": 3,
            "name": "Partner",
            "text": "Work with trusted community groups to shape outreach and reach more people."
          },
          {
            "@type": "HowToStep",
            "position": 4,
            "name": "Launch",
            "text": "Publish your engagement and invite people through County and partner channels."
          },
          {
            "@type": "HowToStep",
            "position": 5,
            "name": "Monitor",
            "text": "Follow ideas, comments, votes, and participation."
          },
          {
            "@type": "HowToStep",
            "position": 6,
            "name": "Organize",
            "text": "Set themes to group related ideas and understand what people share."
          },
          {
            "@type": "HowToStep",
            "position": 7,
            "name": "Update",
            "text": "Post updates when appropriate to share progress and keep people informed."
          },
          {
            "@type": "HowToStep",
            "position": 8,
            "name": "Close",
            "text": "End participation, review results, and publish a recap with next steps."
          }
        ]
      }
    },
