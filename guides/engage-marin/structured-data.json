      "name": "About Engage Marin",
      "headline": "About Engage Marin",
      "description": "Engage Marin is the County of Marin's online community engagement platform. It gives people a simple way to share ideas, give feedback, and help shape County decisions.",
      "inLanguage": "en",
      "audience": {
        "@type": "Audience",
