  "specs": [
    {
      "id": "campaign-title",
      "label": "Campaign title",
      "max": 6,
      "unit": "word",
      "evidence": "Aim for 6 words or fewer."
    },
    {
      "id": "campaign-description",
      "label": "Campaign description",
      "min": 50,
      "max": 100,
      "unit": "word",
      "evidence": "Aim for **50–100 words**."
    },
    {
      "id": "question",
      "label": "Question",
      "max": 10,
      "unit": "word",
      "evidence": "Aim for 10 words or fewer."
    },
    {
      "id": "question-description",
      "label": "Question description",
      "min": 2,
      "max": 4,
      "unit": "sentence",
      "evidence": "Use **2–4 short sentences**"
    },
    {
      "id": "about-page",
      "label": "About page",
      "min": 150,
      "max": 300,
      "unit": "word",
      "evidence": "Aim for **150–300 words**."
    },
    {
      "id": "video-length",
      "label": "Welcome video length",
      "min": 30,
      "max": 60,
      "unit": "second",
      "evidence": "Aim for 30–60 seconds."
    },
    {
      "id": "video-title",
      "label": "Welcome video title",
      "min": 3,
      "max": 8,
      "unit": "word",
      "evidence": "Keep the introduction title to **3–8 words**."
    },
    {
      "id": "video-description",
      "label": "Welcome video description",
      "min": 25,
      "max": 50,
      "unit": "word",
      "evidence": "Aim for **25–50 words**"
    },
    {
      "id": "video-resolution",
      "label": "Video resolution",
      "value": "1080p",
      "evidence": "Resolution: 1080p."
    },
    {
      "id": "video-aspect-ratio",
      "label": "Video aspect ratio",
      "value": "16:9 or 1:1",
      "evidence": "Aspect ratio: 16:9 or 1:1."
    },
    {
      "id": "video-file-type",
      "label": "Video file type",
      "value": "MP4",
      "evidence": "Preferred format: MP4."
    },
    {
      "id": "video-captions",
      "label": "Video captions",
      "value": "Required, using a reviewed WebVTT (.vtt) file",
      "evidence": "Captions: Required, using a reviewed WebVTT (.vtt) file."
    },
    {
      "id": "first-post",
      "label": "First post",
      "min": 75,
      "max": 150,
      "unit": "word",
      "evidence": "Aim for **75–150 words**."
    }
  ],
