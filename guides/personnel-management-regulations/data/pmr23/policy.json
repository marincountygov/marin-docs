  },
  "purpose": {
    "statement": "This Personnel Management Regulation (PMR) presents policy and procedure for the use of electronic media by County employees.",
    "source": {
      "document": "PMR 23",
      "section": "Section 2: Personnel Conduct and Standards of Employment",
      "heading": "Applicability & Purpose",
      "anchor": "applicability-purpose",
      "htmlElement": "p",
      "order": 417
    }
  },
  "scope": {
    "statement": "This Personnel Management Regulation applies to all Marin County employees who use any electronic media provided by the County. Electronic media is defined as computers, computer peripherals, electronic connections, computer software, laptops, voice mail, electronic mail (e-mail), Internet access, World Wide Web access, Intranet (MINE) access, on-line information services, electronic facsimile (fax) files, instant messaging, and any other electronic type of equipment that the County deems as electronic media.",
    "source": {
      "document": "PMR 23",
      "section": "Section 2: Personnel Conduct and Standards of Employment",
      "heading": "23.1 Scope",
      "anchor": "23-1-scope",
      "htmlElement": "p",
      "order": 418
    }
  },
